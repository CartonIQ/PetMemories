<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Modern Bar (blended, no dark shadow) -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_pets"
                android:textColor="@color/on_background"
                android:textSize="28sp"
                android:textStyle="bold"
                android:paddingTop="12dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:paddingBottom="16dp" />

            <!-- Daily Pet Fact Card (24dp rounded corners) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_daily_fact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/primary_container"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐾  DAILY PET FACT"
                        android:textAllCaps="true"
                        android:textColor="@color/on_primary_container"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tv_fact_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/on_primary_container"
                        android:textSize="15sp"
                        android:lineSpacingExtra="3dp"
                        tools:text="Dogs\' sense of smell is about 10,000 to 100,000 times more acute than humans!" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pet List Header -->
            <TextView
                android:id="@+id/tv_pets_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Pets"
                android:textColor="@color/on_background"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tv_empty_pets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="32dp"
                android:gravity="center"
                android:text="@string/no_pets_yet"
                android:textColor="@color/on_surface_variant"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Pets RecyclerView with fade-in animation -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_pets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_pet" />

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB to Add Pet -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_pet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/add_pet"
        android:textColor="@color/on_primary"
        app:icon="@drawable/ic_pets"
        app:iconTint="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PetMemories.LargeCorner" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
